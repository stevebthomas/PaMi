# Supabase (create a project at supabase.com, run supabase/schema.sql, then fill these in)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic (get a key at console.anthropic.com)
ANTHROPIC_API_KEY=

# Per-agent model overrides. Personas default to Haiku (fast/cheap, short in-character
# Slack replies); the evaluator defaults to Sonnet (stronger reasoning for scoring PM skill).
RAJ_MODEL=claude-haiku-4-5
PRIYA_MODEL=claude-haiku-4-5
DEREK_MODEL=claude-haiku-4-5
SAM_MODEL=claude-haiku-4-5
EVALUATOR_MODEL=claude-sonnet-4-6
ASK_CLAUDE_MODEL=claude-haiku-4-5
